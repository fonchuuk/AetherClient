{
  "schemaVersion": 1,
  "id": "aetherglass",
  "version": "${version}",
  "name": "AetherGlass Client",
  "description": "Своё главное меню, экранные элементы и визуальные эффекты, нарисованные кодом: частицы, подсветка блоков, эффекты руки и неба. Никаких шейдеров.",
  "authors": [
    "AetherGlass Client"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.aetherglass.client.AetherGlassClient"
    ]
  },
  "mixins": [
    "aetherglass.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*"
  }
}
